+#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 5, 0)
+#include <asm/unaligned.h>
+#include <crypto/algapi.h>
+#include <crypto/chacha.h>
+#define CHACHA_KEY_WORDS	8
+#define CHACHA_BLOCK_SIZE	64
+#define CHACHA_STATE_WORDS	(CHACHA_BLOCK_SIZE / sizeof(u32))
+
+struct chacha_state {
+	u32 x[CHACHA_STATE_WORDS];
+};
+
+static inline void chacha_init(struct chacha_state *state, const u32 *key, const u8 *iv)
+{
+	state->x[0]  = 0x61707865;
+	state->x[1]  = 0x3320646e;
+	state->x[2]  = 0x79622d32;
+	state->x[3]  = 0x6b206574;
+	state->x[4]  = key[0];
+	state->x[5]  = key[1];
+	state->x[6]  = key[2];
+	state->x[7]  = key[3];
+	state->x[8]  = key[4];
+	state->x[9]  = key[5];
+	state->x[10] = key[6];
+	state->x[11] = key[7];
+	state->x[12] = get_unaligned_le32(iv +  0);
+	state->x[13] = get_unaligned_le32(iv +  4);
+	state->x[14] = get_unaligned_le32(iv +  8);
+	state->x[15] = get_unaligned_le32(iv + 12);
+}
+
+static inline void chacha20_crypt(struct chacha_state *state, u8 *dst, const u8 *src, unsigned int bytes)
+{
+	u8 stream[CHACHA_BLOCK_SIZE] __aligned(sizeof(long));
+	while (bytes >= CHACHA_BLOCK_SIZE) {
+		chacha20_block(state->x, stream);
+		crypto_xor_cpy(dst, src, stream, CHACHA_BLOCK_SIZE);
+		bytes -= CHACHA_BLOCK_SIZE;
+		dst += CHACHA_BLOCK_SIZE;
+		src += CHACHA_BLOCK_SIZE;
+	}
+	if (bytes) {
+		chacha20_block(state->x, stream);
+		crypto_xor_cpy(dst, src, stream, bytes);
+	}
+}
